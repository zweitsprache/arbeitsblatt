generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Folder {
  id         String      @id @default(cuid())
  name       String
  parentId   String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  userId     String?
  parent     Folder?     @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children   Folder[]    @relation("FolderTree")
  worksheets Worksheet[]

  @@index([parentId])
  @@index([userId])
}

model Worksheet {
  id           String    @id @default(cuid())
  title        String    @default("Untitled Worksheet")
  description  String?
  slug         String    @unique
  blocks       Json      @default("[]")
  settings     Json      @default("{}")
  published    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  folderId     String?
  userId       String?
  type         String    @default("worksheet")
  thumbnail    String?
  translatedAt DateTime?
  translations Json      @default("{}")
  folder       Folder?   @relation(fields: [folderId], references: [id])

  @@index([slug])
  @@index([folderId])
  @@index([userId])
  @@index([type])
}

model EBook {
  id            String   @id @default(cuid())
  title         String   @default("Untitled E-Book")
  slug          String   @unique
  chapters      Json     @default("[]")
  coverSettings Json     @default("{}")
  settings      Json     @default("{}")
  published     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  folderId      String?
  userId        String?
  thumbnail     String?

  @@index([slug])
  @@index([folderId])
  @@index([userId])
}

model Course {
  id                String    @id @default(cuid())
  title             String    @default("Untitled Course")
  slug              String    @unique
  structure         Json      @default("[]")
  coverSettings     Json      @default("{}")
  settings          Json      @default("{}")
  published         Boolean   @default(false)
  thumbnail         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  folderId          String?
  userId            String?
  i18nexusNamespace String?
  translatedAt      DateTime?
  translations      Json      @default("{}")

  @@index([slug])
  @@index([folderId])
  @@index([userId])
}

model Presentation {
  id        String   @id @default(cuid())
  title     String   @default("Untitled Presentation")
  slug      String   @unique
  blocks    Json     @default("[]")
  settings  Json     @default("{}")
  published Boolean  @default(false)
  thumbnail String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  folderId  String?
  userId    String?

  @@index([slug])
  @@index([folderId])
  @@index([userId])
}

model AiToolRun {
  id               String          @id @default(cuid())
  toolKey          String
  status           AiToolRunStatus @default(ACTIVE)
  userId           String?
  projectId        String?
  worksheetId      String?
  worksheetBlockId String?
  context          Json            @default("{}")
  state            Json            @default("{}")
  finalResult      Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  finishedAt       DateTime?
  messages         AiToolMessage[]

  @@index([toolKey])
  @@index([status])
  @@index([userId])
  @@index([projectId])
  @@index([worksheetId])
  @@index([createdAt])
}

model AiToolMessage {
  id        String            @id @default(cuid())
  runId     String
  role      AiToolMessageRole
  kind      AiToolMessageKind
  payload   Json
  sequence  Int
  createdAt DateTime          @default(now())
  run       AiToolRun         @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, sequence])
  @@index([runId])
  @@index([role])
  @@index([kind])
  @@index([createdAt])
}

model VerbCache {
  id         String   @id @default(cuid())
  infinitive String   @unique
  data       Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([infinitive])
}

model AppUserAccess {
  id        String   @id @default(cuid())
  userId    String   @unique
  email     String?
  name      String?
  role      String   @default("bronze")
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([email])
  @@index([role])
}

model RoleAccess {
  role      String   @id
  settings  Json     @default("{}")
  updatedAt DateTime @default(now()) @updatedAt
}

model BrandProfile {
  id                       String            @id @default(cuid())
  name                     String
  slug                     String            @unique
  bodyFont                 String            @default("Asap Condensed, sans-serif")
  headlineFont             String            @default("Asap Condensed, sans-serif")
  headlineWeight           Int               @default(700)
  subHeadlineFont          String            @default("Asap Condensed, sans-serif")
  subHeadlineWeight        Int               @default(700)
  headerFooterFont         String            @default("Asap Condensed, sans-serif")
  googleFontsUrl           String            @default("")
  primaryColor             String            @default("#1a1a1a")
  accentColor              String?
  logo                     String            @default("")
  iconLogo                 String?
  favicon                  String?
  organization             String            @default("")
  teacher                  String            @default("")
  headerRight              String            @default("")
  footerLeft               String            @default("")
  footerCenter             String            @default("")
  footerRight              String            @default("")
  pdfFontSize              Float?
  pdfTranslationScale      Float?
  pageTitle                String?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  h1Size                   String?
  h1Weight                 Int?
  h2Size                   String?
  h2Weight                 Int?
  h3Size                   String?
  h3Weight                 Int?
  textBaseSize             String?
  translationFontOverrides Json              @default("{}")
  gameSettings             Json              @default("{}")
  interactiveColor         String            @default("#0ea5e9")
  h1NumberFormat           String?
  h2NumberFormat           String?
  h3NumberFormat           String?
  h4NumberFormat           String?
  h1HeadingColor           String?
  h2HeadingColor           String?
  h3HeadingColor           String?
  h4HeadingColor           String?
  h1HeadingNumberColor     String?
  h2HeadingNumberColor     String?
  h3HeadingNumberColor     String?
  h4HeadingNumberColor     String?
  h1HeadingNumberWeight    Int?
  h2HeadingNumberWeight    Int?
  h3HeadingNumberWeight    Int?
  h4HeadingNumberWeight    Int?
  instructionBadgeStyle    String?           @default("default")
  instructionBadgeColor    String?
  exampleTextFont          String            @default("")
  letterSpacing            String?
  itemNumberFormat         String?           @default("default")
  subProfiles              BrandSubProfile[]
  clients                  Client[]

  @@index([slug])
}

model BrandSubProfile {
  id             String       @id @default(cuid())
  name           String
  brandProfileId String
  headerLeftV1   String       @default("")
  headerRightV1  String       @default("")
  footerLeftV1   String       @default("")
  footerRightV1  String       @default("")
  headerLeftV2   String       @default("")
  headerRightV2  String       @default("")
  footerLeftV2   String       @default("")
  footerRightV2  String       @default("")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  brandProfile   BrandProfile @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)

  @@index([brandProfileId])
}

model Client {
  id             String        @id @default(cuid())
  name           String
  slug           String        @unique
  brandSettings  Json          @default("{}")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  brandProfileId String?
  brandProfile   BrandProfile? @relation(fields: [brandProfileId], references: [id])
  projects       Project[]

  @@index([slug])
  @@index([brandProfileId])
}

model Project {
  id        String           @id @default(cuid())
  name      String
  slug      String           @unique
  clientId  String
  domain    String?          @unique
  settings  Json             @default("{}")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  client    Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contents  ProjectContent[]

  @@index([slug])
  @@index([clientId])
}

model ProjectContent {
  id          String      @id @default(cuid())
  projectId   String
  contentType ContentType
  contentId   String
  createdAt   DateTime    @default(now())
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, contentType, contentId])
  @@index([contentId])
  @@index([projectId])
}

model FlashcardCollection {
  id          String                   @id @default(cuid())
  userId      String
  slug        String                   @unique
  title       String
  description String?
  published   Boolean                  @default(true)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  sets        FlashcardCollectionSet[]

  @@index([slug])
  @@index([userId])
}

model FlashcardCollectionSet {
  id           String              @id @default(cuid())
  collectionId String
  worksheetId  String
  order        Int
  addedAt      DateTime            @default(now())
  collection   FlashcardCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, worksheetId])
  @@index([collectionId])
  @@index([worksheetId])
}

enum AiToolRunStatus {
  ACTIVE
  COMPLETED
  ERROR
  ARCHIVED
}

enum AiToolMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum AiToolMessageKind {
  USER_TEXT
  ASSISTANT_TEXT
  QUESTION_CARD
  ANSWER_CARD
  REVIEW_CARD
  RESULT_CARD
  ERROR_CARD
  SYSTEM_STATUS
}

enum ContentType {
  WORKSHEET
  EBOOK
  COURSE
  AI_TOOL
  PRESENTATION
}
